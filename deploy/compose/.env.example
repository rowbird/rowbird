# The Rowbird release to run, for example 1.0.0.
ROWBIRD_VERSION=
# The public host name; Caddy gets a certificate for it and Rowbird uses it in links.
ROWBIRD_DOMAIN=rowbird.example.com
# Bearer token for /metrics. Leave empty to keep /metrics public (it is then reachable through Caddy).
ROWBIRD_METRICS_TOKEN=
# open, or block-private to stop connections and channels from reaching private addresses.
ROWBIRD_NETWORK_POLICY=open
